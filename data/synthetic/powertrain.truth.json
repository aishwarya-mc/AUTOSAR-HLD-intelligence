        "F-001",
        "Throttle Position Distribution",
        "ThrottleControl publishes ThrottlePosition through IThrottlePosition. EngineControlManager receives the signal through ThrottlePosition_In and updates its internal state model."
      ],
      [
        "F-002",
        "Engine Speed Distribution",
        "CrankSensorManager publishes EngineSpeed through IEngineSpeed. EngineControlManager receives the signal through EngineSpeed_In and updates its internal state model."
      ],
      [
        "F-003",
        "Fuel Demand Distribution",
        "EngineControlManager publishes FuelDemand through IFuelDemand. FuelInjectionControl receives the signal through FuelDemand_In and updates its internal state model."
      ],
      [
        "F-004",
        "Gear Request Distribution",
        "EngineControlManager publishes GearRequest through IGearRequest. TransmissionControl receives the signal through GearRequest_In and updates its internal state model."
      ],
      [
        "F-005",
        "Torque Limit Distribution",
        "TransmissionControl publishes TorqueLimit through ITorqueLimit. EngineControlManager receives the signal through TorqueLimit_In and updates its internal state model."
