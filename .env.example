# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM
LLM_PROVIDER=local
LLM_MODEL=

# Embeddings
EMBEDDING_MODEL=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Database
DATABASE_URL=sqlite:///./data/autosar.db

# Retrieval
TOP_K=8
CHUNK_SIZE=250
CHUNK_OVERLAP=40

# Upload
MAX_UPLOAD_MB=100

# Optional: LLM-written answers (default "local" = offline extractive answers)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Local RAG
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_ENABLED=true
# VECTOR_DIR=data/vectorstore
# OLLAMA_URL=http://localhost:11434

# Access control (off for local development)
AUTH_ENABLED=false
# API_KEYS=admin-key:admin:alice,rev-key:reviewer:bob:projA,view-key:viewer:carol:projA|projB
