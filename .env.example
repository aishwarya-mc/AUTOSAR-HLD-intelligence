# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM
LLM_PROVIDER=ollama   # ollama (local, default) | anthropic (external) | local (no LLM)
LLM_MODEL=llama3.2

# Embeddings
EMBEDDING_MODEL=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Database
DATABASE_URL=sqlite:///./data/autosar.db

# Retrieval
TOP_K=8
CHUNK_SIZE=250
CHUNK_OVERLAP=40

# Upload
MAX_UPLOAD_MB=100

# The local LLM (Ollama) phrases answers from retrieved evidence; if Ollama is not running the system
# falls back to extractive answers. Install: https://ollama.com then `ollama pull llama3.2`.
# ANTHROPIC_API_KEY=   # only for LLM_PROVIDER=anthropic (external API: declare it)

# Local RAG
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_ENABLED=true
# VECTOR_DIR=data/vectorstore
# OLLAMA_URL=http://localhost:11434

# Access control (off for local development)
AUTH_ENABLED=false
# API_KEYS=admin-key:admin:alice,rev-key:reviewer:bob:projA,view-key:viewer:carol:projA|projB
