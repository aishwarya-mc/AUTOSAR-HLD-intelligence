# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM
LLM_PROVIDER=local
LLM_MODEL=

# Embeddings
EMBEDDING_MODEL=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Database
DATABASE_URL=sqlite:///./data/autosar.db

# Retrieval
TOP_K=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Upload
MAX_UPLOAD_MB=100
